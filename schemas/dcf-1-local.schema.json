{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DCF/1 uncompressed local foundation profile",
  "type": "object",
  "required": [
    "dcf",
    "tenant_ref",
    "namespace",
    "object_id",
    "version_id",
    "created_at",
    "media",
    "transform",
    "chunks",
    "integrity",
    "extensions",
    "critical",
    "signatures"
  ],
  "properties": {
    "dcf": {
      "const": "1.0"
    },
    "tenant_ref": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "namespace": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,62}$"
    },
    "object_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "version_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "media": {
      "type": "object",
      "required": [
        "content_type",
        "logical_size"
      ],
      "properties": {
        "content_type": {
          "const": "application/octet-stream"
        },
        "logical_size": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$"
        }
      }
    },
    "transform": {
      "type": "object",
      "required": [
        "chunking",
        "compression",
        "encryption"
      ],
      "properties": {
        "chunking": {
          "type": "object",
          "required": [
            "scheme",
            "plaintext_chunk_bytes"
          ],
          "properties": {
            "scheme": {
              "const": "fixed-v1"
            },
            "plaintext_chunk_bytes": {
              "const": 4194304
            }
          }
        },
        "compression": {
          "type": "object",
          "required": [
            "algorithm"
          ],
          "properties": {
            "algorithm": {
              "const": "none"
            }
          }
        },
        "encryption": {
          "type": "object",
          "required": [
            "suite",
            "key_ref",
            "nonce_scheme",
            "aad_profile"
          ],
          "properties": {
            "suite": {
              "const": "AES-256-GCM"
            },
            "key_ref": {
              "type": "string",
              "pattern": "^dek-wrap:[0-9a-f-]{36}$"
            },
            "nonce_scheme": {
              "const": "dse-gcm-v1"
            },
            "aad_profile": {
              "const": "dcf-aad-v1"
            }
          }
        }
      }
    },
    "chunks": {
      "type": "array",
      "maxItems": 4096,
      "items": {
        "type": "object",
        "required": [
          "index",
          "logical_offset",
          "plaintext_bytes",
          "stored_bytes",
          "nonce",
          "ciphertext_sha256",
          "ciphertext_leaf"
        ],
        "properties": {
          "index": {
            "type": "integer",
            "minimum": 0
          },
          "logical_offset": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)$"
          },
          "plaintext_bytes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4194304
          },
          "stored_bytes": {
            "type": "integer",
            "minimum": 17,
            "maximum": 4194320
          },
          "nonce": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{16}$"
          },
          "ciphertext_sha256": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{43}$"
          },
          "ciphertext_leaf": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{43}$"
          }
        }
      }
    },
    "integrity": {
      "type": "object",
      "required": [
        "hash_algorithm",
        "ciphertext_merkle_root"
      ],
      "properties": {
        "hash_algorithm": {
          "const": "SHA-256"
        },
        "ciphertext_merkle_root": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{43}$"
        }
      }
    },
    "extensions": {
      "type": "object"
    },
    "critical": {
      "type": "array",
      "maxItems": 0
    },
    "signatures": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "object",
        "required": [
          "suite",
          "key_id",
          "signed_at",
          "signature"
        ],
        "properties": {
          "suite": {
            "const": "Ed25519"
          },
          "key_id": {
            "type": "string",
            "pattern": "^ed25519:[A-Za-z0-9_-]{43}$"
          },
          "signed_at": {
            "type": "string",
            "format": "date-time"
          },
          "signature": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{86}$"
          }
        }
      }
    }
  }
}
